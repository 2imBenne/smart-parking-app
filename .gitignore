# ==============================================================================
# SmartParkingHub - React / Vite Web App Git Ignore Configuration
# Comprehensive configuration to prevent committing node_modules, build outputs,
# test coverage, debug logs, local environments, and temporary files.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Package Dependencies & Package Manager Stores
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp
.pnp.js
.pnp.cjs

# ------------------------------------------------------------------------------
# 2. Production Build Outputs & Bundler Caches
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
.cache/
.parcel-cache/
.turbo/
.eslintcache
*.tsbuildinfo

# Vite temporary config dumps
vite.config.ts.timestamp-*
vite.config.js.timestamp-*

# ------------------------------------------------------------------------------
# 3. Test Reports & Code Coverage
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
playwright-report/
test-results/
cypress/videos/
cypress/screenshots/

# ------------------------------------------------------------------------------
# 4. Logs & Debug Traces
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. Local Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Whitelist safe template files
!.env.example
!.env.template

# ------------------------------------------------------------------------------
# 6. IDEs, Editors & Tooling
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# JetBrains / WebStorm / IDEA
.idea/
*.iml
*.iws
*.ipr

# Visual Studio / Windows tools
*.suo
*.ntvs*
*.njsproj
*.sln

# General editor backups & swap files
*.swp
*.swo
*.swn
*~
*.bak

# ------------------------------------------------------------------------------
# 7. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# 8. Temporary & Large Archive Files
# ------------------------------------------------------------------------------
tmp/
temp/
**/tmp/
**/temp/

# Large Archives & Media
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.mp4
*.mov
*.avi
