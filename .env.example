# ==============================================================================
# SMART PARKING HUB (WEB CLIENT) - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Sao chép tệp này thành .env trong thư mục smart-parking-app:
# cp .env.example .env (hoặc copy .env.example .env trên Windows)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API GATEWAY BACKEND URL
# ------------------------------------------------------------------------------
# Địa chỉ trỏ tới Spring Cloud API Gateway (Routing các request /api/v1/**)
VITE_API_URL=http://localhost:8088

# ------------------------------------------------------------------------------
# 2. FEATURE FLAGS & DEMO SETTINGS
# ------------------------------------------------------------------------------
# Bật tính năng nạp tiền ví / thanh toán mô phỏng (Demo PayOS)
# 'true' để bật thử nghiệm trên local dev, 'false' để tắt khi chạy production
VITE_ENABLE_DEMO_PAYMENT=true
